# Variable names only - leave the values empty here. The real .env is ignored by Git and Docker builds.
# Create it with scripts/set-gemini-key.ps1, or edit .env yourself.
# An empty key means "not set" (the app says so); placeholder text would be sent to the API as if it were a key.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional paid provider: Claude Haiku 4.5. Leave unset to keep using Gemini only.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Which provider answers questions in the app: gemini (default) or anthropic.
# ANSWER_PROVIDER=gemini
