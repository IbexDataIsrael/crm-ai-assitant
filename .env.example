# Variable names only - leave the values empty here. The real .env is ignored by Git and Docker builds.
# Create it with scripts/set-gemini-key.ps1, or edit .env yourself.
# An empty key means "not set" (the app says so); placeholder text would be sent to the API as if it were a key.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.8-flash).
# GEMINI_MODEL=gemini-3.8-flash

# Optional paid provider: Claude Haiku 4.5. Leave unset to keep using Gemini only.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Which provider answers questions in the app: gemini (default) or anthropic.
# ANSWER_PROVIDER=gemini

# Database login passwords for the app role (crm_app) and the test role (crm_test).
# Set them with scripts/set-db-passwords.ps1 (hidden input or random; it also sets them in PostgreSQL).
# Written in single quotes so Docker Compose keeps $, #, spaces and backslashes literally.
APP_DB_PASSWORD=
TEST_DB_PASSWORD=
# Server profile only (docker-compose.server.yml): the admin password, read only
# when an empty volume is first created. scripts/set-db-passwords.sh writes all three.
DB_ADMIN_PASSWORD=

# CRM API base address (the CRM's own server, not this app). No default: it must be set.
# Local CRM on this machine: http://localhost:8001/ when the assistant runs outside Docker.
# Inside the Docker container "localhost" is the container itself, so use
# http://host.docker.internal:8001/ there to reach the CRM on the host.
CRM_API_URL=

# CRM web app address (the site people open in a browser), for "open in the CRM" links,
# e.g. a person's page /dashboard/contacts/<id>. Optional: empty -> no links are shown.
CRM_WEB_URL=

# Reverse proxy address(es) whose X-Forwarded-For header is believed for rate
# limiting (IPs or CIDR, comma-separated). Empty: no proxy trusted. See DEPLOY.md.
# TRUSTED_PROXIES=
# /docs and /openapi.json: off unless API_DOCS=on (docker-compose.yml sets it for local work).
# API_DOCS=on
